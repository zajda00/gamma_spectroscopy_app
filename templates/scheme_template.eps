%!PS-Adobe-3.0 EPSF-3.0
%%Title: Scheme of excited states in 122Cd
%%BoundingBox: 0 0 1400 1600
%%Pages: 1
%%BeginDefaults
%%DocumentNeededResources: font Helvetica
%%IncludeResource: font Helvetica
%%EndDefaults
%%Creator: ms 0.02
%%CreationDate: 16/09/14 14.32
%
% Changed by Marek Pfuetzner February 1993
% Changed by Krzysztof Gulda October 1995 and by AK. 
% Rewritten completely by Marek Stryjczyk August 2014
% Additional corrections added in 2017 and 2018 by MS
%
% The file is written from an example of Johan Nyberg, DEC-1990.
%					Holger Jensen, Dec-1990.

%%%% TODO %%%%
% Q value, T1/2 and spin/parity of mother nucleus
% nice label for nucleus separation energy
% 2nd column (after nucleus separation)
% some other stuff

%%BeginProlog

%=======================================================================
% PROJECT VARIABLES
% Wszystkie podstawowe dane projektu i parametry rysowania edytuj tutaj.
% Aplikacja powinna podmieniać tylko te wartości.
%=======================================================================

%-------------------------
% Daughter nucleus
%-------------------------
/dSym (Cd) def                 % daughter nucleus symbol
/dA 122 def                    % daughter mass number A
/dZ 48 def                     % daughter proton number Z
/dN 74 def                     % daughter neutron number N

%-------------------------
% Mother nucleus
%-------------------------
/mShow 1 def                   % 1 = show mother nucleus, 0 = hide
/mSym (Ag) def                 % mother nucleus symbol
/mA 122 def                    % mother mass number A
/mZ 47 def                     % mother proton number Z
/mN 75 def                     % mother neutron number N

%-------------------------
% Decay channel
% 0 = blank
% 1 = alpha
% 2 = beta-
% 3 = beta+
% 4 = beta-n
%-------------------------
/decay 2 def

%-------------------------
% Mother-info display toggles
%-------------------------
/mT12Show 1 def                % show mother half-life
/mSpinparShow 1 def            % show mother spin/parity
/mQShow 1 def                  % show mother Q value
/mSnShow 0 def                 % show mother Sn text
/mPnShow 0 def                 % show mother Pn text

%-------------------------
% Mother values
%-------------------------
/mT12 () def                   % e.g. (0.72(10) s)
/mSpinpar () def               % e.g. ((1-), (9-))
/mQ () def                     % e.g. (9510(40) keV)
/mSn () def                    % e.g. (5834 keV)
/mPn () def                    % e.g. (12.3)

%-------------------------
% Separation-energy helper line
%-------------------------
/sNuclShow 0 def               % 1 = show separation-energy level
/sNucl 0 def                   % separation energy in keV
/sNuclType (n) def             % (n) neutron, (p) proton

%-------------------------
% Level-side annotations
%-------------------------
/betapcShow 1 def              % show beta feeding
/logftShow 1 def               % show logft
/spinparShow 1 def             % show level spin/parity
/t12Show 1 def                 % show level half-life

%-------------------------
% Drawing scales and layout
%-------------------------
/scaleX {0.1 mul} def          % horizontal scale helper
/scaleE {2.7 mul} def          % energy scale helper
/fontSize 15 def               % level font size
/fontSizeTrans 12 def          % transition font size

%-------------------------
% Color convention
%-------------------------
% 0 = black, accepted
% 1 = red, new
% 2 = blue, literature / unevaluated
% 3 = green, helper / separation line

%-------------------------
% Dashed convention
%-------------------------
% 0 = solid
% 1 = dashed
% -1 = long-dashed

% Some magic functions
/s 20 string def
/cm {28.3464567 mul} def


%convert 2 vars name (e.g. stringwidth) to 1 var
/xytox {
2 dict begin
	/y exch def
	/x exch def
x
end
} def

%convert 2 vars name (e.g. stringwidth) to 1 var
/xytoy {
2 dict begin
	/y exch def
	/x exch def
y
end
} def

%convert 4 vars name (e.g. search results) to 1 var
/abcdtoa {
4 dict begin
	/d exch def
	/a exch def
	/b exch def
	/c exch def
a
end
} def

%convert 4 vars name (e.g. search results) to 1 var
/abcdtoc {
4 dict begin
	/d exch def
	/a exch def
	/b exch def
	/c exch def
c
end
} def


%function to draw assymetric uncertainties
/assymShow {   
5 dict begin
	/temp exch def	%string
	/val 0 def
	/uncplus 0 def
	/uncminus 0 def
	/unit 0 def
	
	temp stringwidth xytox 0 gt {
		temp (+) search true eq { 
			pop pop pop
			/val {temp (+) search abcdtoa} def
			/uncplus {temp (+) search abcdtoc (-) search abcdtoa} def
			temp ( ) search true eq {
				pop pop pop
				/uncminus {temp (+) search abcdtoc (-) search abcdtoc ( ) search abcdtoa} def
				/unit {temp (+) search abcdtoc (-) search abcdtoc ( ) search abcdtoc} def
			} {
				pop
				/uncminus {temp (+) search abcdtoc (-) search abcdtoc} def
				/unit () def
			} ifelse
			
			val show
			gsave
				/Helvetica findfont fontSize 0.8 mul scalefont setfont
				2 fontSize 0.4 mul rmoveto
				(+) show
				uncplus show
			grestore
			gsave
				/Helvetica findfont fontSize 0.8 mul scalefont setfont
				2 fontSize 0.4 mul -1 mul rmoveto
				(\261) show
				uncminus show
			grestore
			uncminus stringwidth xytox (+) stringwidth xytox add 0 rmoveto
			unit show
		} {
			pop
			temp show
		} ifelse
	} if
end
} def

%if some values (beta feeding, logft) are eneabled, it moves start point of levels in x direction
/levelStartX {
1 dict begin
	/t 0 def
	betapcShow 1 eq {
		/t 2.3 cm t add def
	} if
	logftShow 1 eq {
		/t 2.3 cm t add def
	} if
t
end
} def

%if some values (spin/parity, T1/2) are eneabled, it moves end point of levels in x direction
/levelEndX {
1 dict begin
	/t 33.0 cm def        %!!!!!!!!!!!!!!!!!!!!!Tu mozna wydluzyc level 
	%spinparShow 1 eq {
	%	/t t 1.5 cm sub def
	%} if
	t12Show 1 eq {
		/t t 0 cm sub def
	} if
t
end
} def

%start point of levels in E direction
/levelStartE 42 def

%if mother nucleus is shown, it moves end point of levels in E direction
/scaleEmn {
1 dict begin
	mShow 1 eq {
		/t 0.95 def
	} {
		/t 1 def
	} ifelse
t mul
end
} def

%convert hyphens (-) in argument string to minus signs
/convertToMinus {   
3 dict begin
	/temp exch def
	/count 0 def
	temp {
		/t1 exch def
		t1 45 eq {
			/t1 177 def
		} if
		temp count t1 put 
		count 1 add
		/count exch def
	} forall temp
end
} def

%version of show that superscripts + and - (for parities)
/upShow { 
3 dict begin
	/fz exch def %fontsize
	/t exch def
	t {
		/t1 exch def
		/s (x) def
		s 0 t1 put
		t1 43 eq t1 177 eq or {
			1 fz 0.5 mul rmoveto 
			s show 
			1 fz 0.5 mul neg rmoveto
		} {
			s show
		} ifelse
	} forall 
end
} def

/labelLine {
4 dict begin
	/y levelStartE 18 sub def %y position of label line
	/t 0 def
	/f 1 def %font scale
	/Elabel (E (keV)) def
	/Helvetica findfont fontSize f mul scalefont setfont

	%logft label
	logftShow 1 eq {
		0.0 cm y moveto
		(log(ft)) show
		/t 2.4 cm def
	} if

	%betapc label
	betapcShow 1 eq {
		0 cm t add y moveto
		/Helvetica findfont fontSize f mul scalefont setfont
		(I) show
		0 -5 rmoveto
		/Symbol findfont fontSize f mul 0.8 mul scalefont setfont
		(b)  show
		0 5 rmoveto
		/Helvetica findfont fontSize f mul scalefont setfont
	} if
	
	%draw daughter nucleus
	dSym dA dZ levelEndX levelStartX add 2 div 35 add Elabel stringwidth xytox sub y 10 sub nucleus
	%0 40 translate
	
	%energy label
	levelEndX Elabel stringwidth xytox 50 sub sub y moveto %!!!!!!!!!!!!!!!!!!!!! przesuwanie energii w prawo
	/Helvetica findfont fontSize f mul scalefont setfont
	Elabel show
	/t 0 def

	%spin/parity label
	%spinparShow 1 eq {
	%	levelEndX 0.3 cm add y moveto
	%	(I) show
	%	/Symbol findfont fontSize f mul scalefont setfont
	%	(p) 1 fontSize f mul 0.3 mul rmoveto show
	%	/Helvetica findfont fontSize f mul scalefont setfont
	%	/t 1.5 cm def
	%} if

	%T1/2 label
	%t12Show 1 eq {
	%	levelEndX 1.75 cm add t add y moveto
	%	(T) show
	%	0 -5 rmoveto
	%	/Helvetica findfont fontSize f mul 0.8 mul scalefont setfont
	%	(1/2) show
	%	/Helvetica findfont fontSize f mul scalefont setfont
	%	0 5 rmoveto
	%} if
end
} def

% show symbol of the nucleus
/nucleus {
	6 dict begin
		%(x,y) coordinates of nucleus
		/y exch def 
		/x exch def

		%A, Z and symbol of the nucleus
		/z exch def
		/a exch def
		/sym exch def

		%N is calculated
		/n {a z sub} def

		/Helvetica-Bold findfont 17 scalefont setfont

		%startpoint
		x y moveto 
		gsave
			/Helvetica-Bold findfont 23 scalefont setfont
				0  0 rmoveto sym show %symbol of nucleus
			/Helvetica-Bold findfont 17 scalefont setfont
				0 -11 rmoveto n s cvs show %number of neutrons
		grestore
		gsave
			%condition for 3-digits A
			a 100 lt {
			-20  10 rmoveto a s cvs show
			} {
			-31  10 rmoveto a s cvs show
			} ifelse
		grestore
		gsave
			-20 -11 rmoveto z s cvs show %number of protons
		grestore	

		/Helvetica findfont 17 scalefont setfont		
	end
} def


%draw mother nucleus (if necessary)
/motherNucleus {
mShow 1 eq {
	%if blank or beta- decay - arrow on the left
	%for beta+ and alpha - arrow on the right

	decay 1 ne decay 3 ne and { %if not beta+ or alpha i.e. blank beta- or beta-n decay, but left arrow is much more popular
		%draw mother nucleus
		mSym mA mZ 2.2 cm 52.5 cm nucleus		

		%arrow of mother nucleus
		newpath
		1 setlinewidth
		0.5 cm 53.5 cm moveto 
			
		4.5 cm 0 cm rlineto
		1.5 cm -2.5 cm rlineto stroke
		
		newpath
		/Helvetica findfont fontSize scalefont setfont

		% line 1: spin/parity close to the mother nucleus
		0.5 cm 53.6 cm moveto
		mSpinparShow 1 eq {
			mSpinpar convertToMinus fontSize upShow
		} if
		stroke

		% line 2: mother-state half-life under the mother nucleus, above Q-value
		mT12Show 1 eq {
			newpath
			/Helvetica findfont fontSize scalefont setfont
			0.8 cm 49.1 cm moveto
			mT12 assymShow
			stroke
		} if


		%drawing arrowhead
		6.5 cm 51 cm 0.5 cm 30 arrow

		/Symbol findfont 20 scalefont setfont %symbol font
		6 cm 53.25 cm moveto %start point for decay symbol

		decay 2 eq { %beta- decay
			(b) show %beta symbol
			/Helvetica findfont 20 scalefont setfont
			(-) convertToMinus 20 upShow %- symbol
			mQShow 1 eq {
				0.6 cm 47.25 cm moveto %start point for decay symbol
				/Helvetica findfont fontSize scalefont setfont
				(Q) show
				0 -0.13 cm rmoveto
				/Symbol findfont fontSize 2 mul 3 div scalefont setfont
				(b) show
				0 0.13 cm rmoveto
				/Helvetica findfont fontSize scalefont setfont
				( = ) show
				mQ show
			} if
			mSnShow 1 eq {
				7.5 cm 23.55 cm moveto %start point for decay symbol
				/Helvetica findfont fontSize scalefont setfont
				(S) show
				0 -0.13 cm rmoveto
				/Helvetica findfont fontSize 2 mul 3 div scalefont setfont
				(n) show
				0 0.13 cm rmoveto
				/Helvetica findfont fontSize scalefont setfont
				( = ) show
				mSn show
			} if
			mPnShow 1 eq {
				7.5 cm 22.85 cm moveto %start point for decay symbol
				/Helvetica findfont fontSize scalefont setfont
				(P) show
				0 -0.13 cm rmoveto
				/Helvetica findfont fontSize 2 mul 3 div scalefont setfont
				(n) show
				0 0.13 cm rmoveto
				/Helvetica findfont fontSize scalefont setfont
				( = ) show
				mPn assymShow
			} if
		} {
			decay 4 eq { %beta- decay
				(b) show %beta symbol
				/Helvetica findfont 20 scalefont setfont
				(-) convertToMinus 20 upShow %- symbol
				(n) show %show n (for delayed neutron
			} if %end of decay 4 eq if
		} ifelse %end of decay 2 eq if

	} { % else (beta+ or alpha decay)
		%draw mother nucleus
		mSym mA mZ 14 cm 24.6 cm nucleus

		%arrow of mother nucleus
		newpath
		1 setlinewidth
		16.5 cm 25.5 cm moveto 
		-5 cm 0 cm rlineto
		-1.5 cm -2.5 cm rlineto stroke

		newpath
		/Helvetica findfont fontSize scalefont setfont
		12.6 cm 25.7 cm moveto
		mSpinparShow 1 eq {
			mSpinpar convertToMinus fontSize upShow
		} if
		mT12Show 1 eq {
			mSpinparShow 1 eq {
			(   ) show
			} if
			mT12 assymShow
		} if
		stroke

		%drawing arrowhead
		10 cm 23 cm 0.5 cm -30 arrow

		/Symbol findfont 20 scalefont setfont %symbol font
		10 cm 24.25 cm moveto %start point for decay symbol

		decay 1 eq { %alpha decay
			(a) show 
		} {
			decay 3 eq {%beta+ decay
				(b) show %beta symbol
				/Helvetica findfont 20 scalefont setfont
				(+) 20 upShow %+ symbol
				
				mQShow 1 eq {
					11 cm 23.25 cm moveto %start point for decay symbol
					/Helvetica findfont fontSize scalefont setfont
					(Q) show
					0 -0.13 cm rmoveto
					/Symbol findfont fontSize 2 mul 3 div scalefont setfont
					(b) show
					0 0.13 cm rmoveto
					/Helvetica findfont fontSize scalefont setfont
					( = ) show
					mQ show
				} if
			} if %end of decay 3 eq if
		} ifelse %end of decay 1 eq if
	} ifelse %end of left or right arrow if
} if %end of show mother nucleus if

} def

%create arrowhead on given coordinates, angle and length
/arrow {
4 dict begin
	%var definition
	/angle exch def
	/length exch def
	/y exch def
	/x exch def
	
	%start point	
	x y moveto

	%rotate everything
	angle rotate

	%paint arrowhead
	0.53 length mul length rlineto
	1 length neg mul 0 rlineto fill

	%rotate everything again
	angle neg rotate
end
} def

%draw logft and betapc if necessary
/leftValuesDraw {
5 dict begin
	/y exch def
	/logft exch def
	/betapc exch def

	/y y 3 add def
	/x 0 def

	logftShow 1 eq {
		x y moveto
		logft show
		/x 2.4 cm def
	} if
	betapcShow 1 eq {
		x y moveto
		betapc assymShow
		%betapc show
	} if

end
} def

%draw spin/parity if necessary
/spinDraw {
	/Jpi exch def
	spinparShow 1 eq {
		0 3 rmoveto
		Jpi convertToMinus fontSize upShow
	} if
} def

%draw T1/2 if necessary
/rightValuesDraw {
2 dict begin
	/y exch 3 add def
	/t12 exch def

	t12Show 1 eq {
		levelEndX 0.75 cm add y moveto
		t12 assymShow
		%t12 show
	} if
end
} def

%draw nice energy label
/labelEnergy {
4 dict begin
	/E exch def
	52.4952 E stringwidth xytox sub 0 rmoveto %!!!!!!!!!!!!!!!!!!!!! przesuwanie energii w prawo
	5 3 rmoveto
	E show
	%currentpoint xytox s cvs show
end
} def

%draw energy levels
/level {
11 dict begin
	/linecolor exch def
	/dashed exch def
	/t12 exch def
	/E exch def
	/Jpi exch def
	/Estring exch def
	/betapc exch def
	/logft exch def
	/lastLevelEndELabel exch def

	/Helvetica findfont fontSize scalefont setfont

	%y expected (levelStartE + E*0.1*scaleE)
	/y1 levelStartE 0.1 scaleEmn scaleE E mul add def

	%y of last energy label plus label
	/y2 lastLevelEndELabel fontSize add 3 add def

	/y1my2 y1 y2 sub def	%y1 - y2
	
	linecolor 1 eq {
		%1 0 1 setrgbcolor
		1 0 0 setrgbcolor
	} 
	{
		linecolor 2 eq {
			%0.251 0.8784 0.8157 setrgbcolor %RGB 64,224,208
			0 0 1 setrgbcolor %RGB 64,224,208
		} 
		{
			linecolor 3 eq {
				%0.2235 1 0.0784 setrgbcolor %RGB: 57 255 20
				%1 0.5898 0 setrgbcolor %RGB: 57 255 20
				0 0.5 0.0 setrgbcolor %RGB: 0 128 0
			} 
			{
				0 0 0 setrgbcolor
			} ifelse
		} ifelse 
	} 
	ifelse % red if linecolor = 1, blue if linecolor = 2; otherwise black
	
	% dashed line if dash > 0 or special dash for -1
	dashed 0 gt { 
		[4 4] 0 setdash
	} {
		dashed -1 eq {
			[4 7] 0 setdash
		} if
	} ifelse

	0.4 setlinewidth

	y1my2 0 gt { %if y1 - y2 >= 0 draw normal line
		y1 %put new value of /lastLevelEndELabel on stack	
		newpath
		betapc logft y1 leftValuesDraw
		levelStartX y1 moveto
		gsave
			Jpi spinDraw
		grestore
		levelEndX y1 lineto
		-1.20 cm 0 rmoveto
		Estring labelEnergy
		%Jpi t12 y1 rightValuesDraw
		t12 y1 rightValuesDraw
		stroke

	} { %if not, do some steps for energy label and other stuff
		y2 %put new value of /lastLevelEndELabel on stack	
		newpath
		logftShow 1 eq betapcShow 1 eq or spinparShow 1 eq or {
			betapc logft y2 leftValuesDraw
			levelStartX y2 moveto
			gsave
				Jpi spinDraw
			grestore
			1.5 cm 0 rlineto   %Stojaki na spiny i parzystości
			0.75 cm y1my2 rlineto
		} {
			levelStartX y1 moveto
		} ifelse
		levelEndX 2.5 cm sub y1 lineto %tu zmieniami długosc poziomow!!!
		levelEndX 1.5 cm sub y2 lineto
		gsave
		%2 2 rmoveto
		0.1 cm 0 rmoveto %przesuwanie labelki energii
		Estring labelEnergy
		grestore
		1.3 cm 0 rlineto   %tutaj dłougosc stojaka na energie 
		%Jpi t12 y2 rightValuesDraw
		t12 y2 rightValuesDraw
		stroke
	} ifelse
	[] 0 setdash
end
} def

%box for energy label
/labelBox {
4 dict begin
	/ly exch def 	%length y
	/lx exch def 	%length x
	/sy exch def	%start point y
	/sx exch def	%start point x

	%drawing box
	newpath
		sx sy moveto
		lx 0 rlineto
		0 ly rlineto
		lx neg 0 rlineto
	closepath

	%filling box
	1 1 1 setrgbcolor fill
end
} def

%draw transitions
/trans {
12 dict begin
	/linecolor exch def

	/dashed exch def
	dashed 0 gt { 
		[4 4] 0 setdash
	} if % dashed line if dash > 0

	/thickness exch 40 div def
	thickness setlinewidth %set thickness of gamma transition

	/Eto exch def
	/Efrom exch def
	/dE exch def
	/E exch def
	/dI exch def
	/I exch def
	/x exch def %x coordinate

	x fontSizeTrans sub 4.8 scaleX sub %magic x for next transition

	/Helvetica findfont fontSizeTrans scalefont setfont %set font for gamma energy

	/y1 levelStartE 0.1 scaleEmn scaleE Efrom mul add def
	/y2 levelStartE 0.1 scaleEmn scaleE Eto mul add def

	linecolor 1 eq {
		%1 0 1 setrgbcolor
		1 0 0 setrgbcolor
	} {
		linecolor 2 eq {
			%0.251 0.8784 0.8157 setrgbcolor %RGB 64,224,208
			0 0 1 setrgbcolor %RGB 64,224,208
		} {
			linecolor 3 eq {
				%0.2235 1 0.0784 setrgbcolor %RGB: 57 255 20
				%1 0.5898 0 setrgbcolor %RGB: 57 255 20
				0 0.5 0.0 setrgbcolor %RGB: 0 128 0
			} {
				0 0 0 setrgbcolor
			} ifelse
		} ifelse 
	} ifelse % red if linecolor = 1, blue if linecolor = 2; otherwise black
	
	newpath
		%drawing arrowehead
		gsave
		thickness 3 gt {
			x y2 thickness 1.7 mul 0 arrow
		} {
			x y2 3 1.7 mul 0 arrow
		} ifelse
		grestore
		
		%drawing arrow
		x y1 moveto %start point
		x y2 thickness 1.69 mul add lineto %arrow
		
		x fontSizeTrans 0.3 mul add y1 2 add moveto %startpoint for energy label ((x,y1) + (fontshift, 2))

		%drawing white box for energy label
		gsave
			/lx {
				/Helvetica findfont fontSizeTrans scalefont setfont
				/t E stringwidth xytox 2 add def
				dE stringwidth xytox 0 gt { /t t 2 scaleE add dE stringwidth xytox add def } if
				I stringwidth xytox 0 gt { /t t 6 scaleE add I stringwidth xytox add 2 add def } if
				dI stringwidth xytox 0 gt {	/t t 2 scaleE add dI stringwidth xytox add def } if
				/t t 1 mul def
			t
			} def
			x fontSizeTrans 0.5 mul sub 1 sub 	%x
			y1 1 add 							%y
			fontSizeTrans 1 add 				%ly
			lx									%lx
			labelBox 
		grestore

		%drawing energy label
		gsave
			%0 0 0 setrgbcolor
			90 rotate 														%drawing text is much easier in landscape mode
				E show 														%show energy

				/Helvetica-Italic findfont fontSizeTrans scalefont setfont 		%change font for dE
				2 scaleE 0 rmoveto 											%space between E and dE
				dE show 													%show energy uncertainty

				/Helvetica findfont fontSizeTrans scalefont setfont 		%change font for intensity
				6 scaleE 0 rmoveto 										%space between dE and I
				I show														%show intensity

				/Helvetica-Italic findfont fontSizeTrans scalefont setfont	 	%change font for dI
				2 scaleE 0 rmoveto 											%space between I and dI
				dI show 													%show intensity uncertainty

			90 neg rotate 													%but finally the portrait mode is expected
		grestore
	stroke
	0 0 0 setrgbcolor

	[] 0 setdash %set next line non-dashed
end
} def

%convert u to micro
/convertToMicro {
3 dict begin
	/temp exch def
	/count 0 def
	temp {
		/t1 exch def
		t1 117 eq {
			/Symbol findfont 10 scalefont setfont %symbol font
				(m) show
			/Helvetica findfont 10 scalefont setfont
		} {
			t1 show
		} ifelse
		temp count t1 put 
		count 1 add
		/count exch def
	} forall temp
end
} def

/nucleusSeparationLevel {
1 dict begin
%%%%%TODO
%nice label with n or p in subscript
	/label {
	%	(S)
	%	0 fontSize 2 div neg rmoveto
	%	sNuclType
		%0 fontSize 2 div rmoveto
		%(=)
		%sNucl s cvs
		()
	} def
	sNuclShow 1 eq {
		0 () () label () sNucl () -1 level
	} if
end
} def

%magic function which prepare page (what a surprise) i.e. draw energy levels, nuclei symbols and other stuff
%it has to be run at the beginning of every page, otherwise some programs couldn't show pages correctly or it could be some problems with printing
/preparePage {

%margin
%0 cm 0.1 cm translate
%0 cm 5.1 cm translate




%draw mother nucleus (if necessary)
%0 cm -10.5 cm translate
%0 0 0 setrgbcolor %RGB 64,224,208
%motherNucleus
%0 0 0 setrgbcolor
%-0 cm 10.5 cm translate

0 cm 0.1 cm translate
0 0	 0.0 setrgbcolor %RGB: 0 128 0
motherNucleus
0 0 0 setrgbcolor
5.5 cm 3 cm translate

labelLine

nucleusSeparationLevel

%-----------------------------------------------------------------------------
% LEVELS:
%-----------------------------------------------------------------------------

0 %begining value of /lastLevelEndELabel

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% HOW TO EDIT LEVEL LINES
%%
%% Format jednej linii:
%% (logft) (betapc) (E_label) (Jpi) E_level (T12) dashed color level
%%
%% Znaczenie pól:
%% (logft)   - napis po lewej, np. (5.72) albo ()
%% (betapc)  - napis po lewej, np. (7.467) albo ()
%% (E_label) - tekst energii wyświetlany przy poziomie, np. (569.36)
%% (Jpi)     - spin/parity poziomu, np. (2+) albo ()
%% E_level   - wartość energii poziomu jako liczba, np. 569.36
%% (T12)     - półokres poziomu, np. (2.4 ns) albo ()
%% dashed    - 0 linia ciągła, 1 linia przerywana, -1 specjalna przerywana
%% color     - 0 czarny, 1 czerwony, 2 niebieski, 3 zielony
%%
%% UWAGA:
%% Pierwsza wartość na stosie przed pierwszą linią level to poprzednia pozycja
%% etykiety energii, ustawiona przez marker:
%% 0 %begining value of /lastLevelEndELabel
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% PRZYKŁAD 1: poziom podstawowy
% ()     ()        (0.00)      (0+)        0.00      ()        0   0   level

% PRZYKŁAD 2: poziom pewny
% (5.72) (7.467)   (569.36)    (2+)        569.36    ()        0   0   level

% PRZYKŁAD 3: poziom niepewny / pomocniczy
% ()     ()        (2196.41)   ()          2196.41   ()        1   2   level


levelEndX 2.3 cm sub %begining (max) value of x coordinate for transitions


} def %end of /preparePage

%%EndProlog

%-------------------------------------------------------------------------------
% TRANSITIONS:
%-------------------------------------------------------------------------------

%(I) (dI) (E [keV]) (dE) Efrom Eto thickness dashed color trans
%color 0 - black - accepted
%color 1 - red - new
%color 2 - blue - literature / unevaluated
%color 3 - green - helper / separation related

%%Page: 1 1
preparePage

levelEndX 2.3 cm sub %begining (max) value of x coordinate for transitions

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% HOW TO EDIT TRANSITION LINES
%%
%% Format użycia po markerze levelEndX...:
%% (I) (dI) (E_label) (dE) Efrom Eto thickness dashed color trans
%%
%% Znaczenie pól:
%% (I)       - etykieta intensywności, np. () albo ()
%% (dI)      - etykieta niepewności intensywności, zwykle ()
%% (E_label) - etykieta energii i intensywności, np. (569.4 (100.0))
%% (dE)      - niepewność energii jako tekst, np. () albo (0.2)
%% Efrom     - energia poziomu początkowego
%% Eto       - energia poziomu końcowego
%% thickness - grubość strzałki, zwykle 50 dla standardowej linii
%% dashed    - 0 ciągła, 1 przerywana
%% color     - 0 czarna, 1 czerwona, 2 niebieska, 3 zielona
%%
%% UWAGA:
%% Pierwsza wartość x dla pierwszego przejścia jest już ustawiona przez:
%% levelEndX 2.3 cm sub
%% Funkcja /trans zwraca nową wartość x dla następnej linii, więc kolejne
%% przejścia można wpisywać jedno pod drugim bez ręcznego podawania x.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% PRZYKŁAD 1: przejście pewne
% () () (569.4 (100.0)) ()   569.36 0.00    50 0 0 trans

% PRZYKŁAD 2: przejście nowe
% () () (2031.7 (0.7))  ()   4955.00 2923.29 50 0 1 trans

% PRZYKŁAD 3: przejście niepewne
% () () (875.3 (1.5))   ()   2854.24 1978.97 50 1 2 trans


showpage
